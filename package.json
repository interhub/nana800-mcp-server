{
  "name": "nana800-mcp-server",
  "version": "1.1.0",
  "description": "MCP Server for nana800.io Public API - enables AI IDEs to interact with your no-code projects",
  "type": "module",
  "license": "MIT",
  "homepage": "https://nana800.io",
  "files": [
    "dist"
  ],
  "bin": {
    "nana800-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nana800",
    "ai",
    "cursor",
    "claude",
    "no-code",
    "low-code",
    "automation",
    "api"
  ]
}
